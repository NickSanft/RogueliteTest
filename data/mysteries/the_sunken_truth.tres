[resource]
script = ExtResource("1")
MysteryId = "the_sunken_truth"
SortOrder = 1
Name = "The Sunken Truth"
Description = "Something ancient stirs beneath the coastal waters. Its servants walk among the drowned. Its signals pulse from the deep. The truth of what lies below can be uncovered — if you are willing to descend."
RequiredProgress = 5
CompletionText = "You understand now. Not in words — words are too small for this — but in the way a body understands cold, or height, or the wrongness of a sound in an empty house. The thing beneath the water has been here since before the town, before the cliff, before the sea had its current name. It did not call to you. It simply noticed you, the way a tide notices a stone. You carry this knowledge out of the catacomb and back into the pale daylight, and you know that you will never entirely leave."
