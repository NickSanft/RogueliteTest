[resource]
script = ExtResource("1")
EventId = "combat_drowned_watcher_victory"
EventText = "The Drowned Watcher collapses into the shallow water. A foul smell rises from where it fell, and then it is gone — absorbed back into the dark. You stand in the sudden quiet, breathing hard, the sea unconcerned."
