[gd_resource type="Resource" script_class="LocationResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/LocationResource.cs" id="1"]

[resource]
script = ExtResource("1")
LocationId = "old_library"
LocationName = "Old Library"
Description = "The library predates the town by at least two centuries, though no one knows who built it or why here. The catalogue system follows a logic that does not correspond to subject, author, or date. Books shelve themselves differently each visit. The deeper stacks have never been fully mapped."
ImagePath = ""
EventPool = ["library_forbidden_tome", "library_dusty_mirror", "library_hidden_archive"]
TurnCost = 1
SortOrder = 1
UnlockedByDefault = true
